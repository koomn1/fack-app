<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <LinearLayout
        android:id="@+id/layoutRegister"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="30dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="سوريا كاش"
            android:textColor="@color/gold"
            android:textSize="28sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="سجل الآن واستلم 25 دولار في محفظتك"
            android:textColor="@color/text_gray"
            android:layout_marginBottom="40dp" />

        <EditText
            android:id="@+id/etName"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="الاسم الثلاثي"
            android:textColor="@color/text_white"
            android:textColorHint="@color/text_gray"
            android:background="@drawable/bg_input"
            android:padding="15dp"
            android:layout_marginBottom="15dp" />

        <EditText
            android:id="@+id/etPhone"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="رقم الهاتف (09xxxxxxxx)"
            android:inputType="phone"
            android:textColor="@color/text_white"
            android:textColorHint="@color/text_gray"
            android:background="@drawable/bg_input"
            android:padding="15dp"
            android:layout_marginBottom="30dp" />

        <Button
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="تسجيل الدخول"
            android:backgroundTint="@color/gold"
            android:textColor="#000000"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutWallet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_margin="20dp"
            app:cardBackgroundColor="@color/card_dark"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="الرصيد الحالي"
                    android:textColor="@color/text_gray" />

                <TextView
                    android:id="@+id/tvBalance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="25.00 $"
                    android:textColor="@color/text_white"
                    android:textSize="42sp"
                    android:textStyle="bold"
                    android:layout_marginTop="5dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="سحب الأرباح"
            android:textColor="@color/gold"
            android:paddingHorizontal="20dp"
            android:textStyle="bold"
            android:textSize="18sp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            app:cardBackgroundColor="@color/card_dark"
            app:cardCornerRadius="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="أدخل رقم محفظتك (سيرياتيل كاش / MTN كاش) لسحب 500 $:"
                    android:textColor="@color/text_white"
                    android:layout_marginBottom="15dp" />

                <EditText
                    android:id="@+id/etWalletNumber"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:hint="09xxxxxxxx"
                    android:inputType="phone"
                    android:textColor="@color/text_white"
                    android:textColorHint="@color/text_gray"
                    android:background="@drawable/bg_input"
                    android:padding="15dp"
                    android:layout_marginBottom="15dp" />

                <Button
                    android:id="@+id/btnWithdraw"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:text="سحب المبلغ"
                    android:backgroundTint="@color/green"
                    android:textColor="#000000"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F00A0A0A"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">
        <ProgressBar
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:indeterminateTint="@color/gold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="جاري تأمين عملية السحب..."
            android:textColor="@color/text_white"
            android:layout_marginTop="20dp" />
    </LinearLayout>
</RelativeLayout>
